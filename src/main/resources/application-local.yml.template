# Copy this file to application-local.yml (gitignored) and fill in real values.
# Run Spring Boot with --spring.profiles.active=local to use it.
spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/chess_openings
    username: chess
    password: chess
  jpa:
    show-sql: true

claude:
  api-key: YOUR_ANTHROPIC_API_KEY_HERE
  model: claude-haiku-4-5

voyage:
  api-key: YOUR_VOYAGE_API_KEY_HERE
  model: voyage-4-lite

jwt:
  secret: YOUR_JWT_SECRET_HERE_min32chars
  expiration-ms: 86400000   # 24 hours
