# Copy this file to application-local.yml (gitignored) and fill in real values.
# Run Spring Boot with --spring.profiles.active=local to use it.
spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/chess_openings
    username: chess
    password: chess
  jpa:
    show-sql: true

claude:
  api-key: YOUR_ANTHROPIC_API_KEY_HERE
  model: claude-haiku-4-5

voyage:
  api-key: YOUR_VOYAGE_API_KEY_HERE
  model: voyage-4-lite
  # Free Voyage tier is 3 req/min; ingestion spaces requests out by this much.
  min-request-interval: 21s

# Run the theory ingestion job (parses backend/src/main/resources/theory/*.yaml,
# embeds it, writes opening_variations + theory_chunks) then exits:
#   ./mvnw spring-boot:run -Dspring-boot.run.arguments=--ingest.enabled=true \
#       -Dspring-boot.run.profiles=local
# Re-runnable: only chunks whose text changed are re-embedded.

jwt:
  secret: YOUR_JWT_SECRET_HERE_min32chars
  expiration-ms: 86400000   # 24 hours
